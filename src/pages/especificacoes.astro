---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="SmartRuler OS | Especificações Técnicas">
  <div class="specs-container mx-auto p-4 flex flex-col gap-6">
    <!-- Page Header -->
    <div
      class="flex justify-between items-end border-b border-outline-variant pb-2"
    >
      <div>
        <h1
          class="text-2xl font-bold uppercase tracking-tighter italic text-on-surface font-display"
        >
          ESPECIFICAÇÕES TÉCNICAS — SMART RULER (SMR)
        </h1>
      </div>
      <div class="status-badge px-2 py-0-5 rounded-sm font-mono">
        Atualização Via O.T.A
      </div>
    </div>

    <!-- Spec Content -->
    <div class="manual-content">
      <p class="lead-text">
        Este documento detalha a lógica de funcionamento, protocolos de rede e
        arquitetura de software do Smart Ruler (SMR).
      </p>

      <hr class="divider" />

      <h2
        class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl"
      >
        1. Resumo Técnico
      </h2>

      <div class="tech-illustration-container mb-6">
        <img
          src="/SMR-desenho-tecnico.svg"
          alt="Desenho Técnico Smart Ruler SMR-V2"
          class="tech-illustration"
        />
      </div>

      <p>
        Abaixo, os parâmetros técnicos consolidados do Smart Ruler SMR-V2 para
        referência rápida em campo:
      </p>

      <div class="datasheet-wrapper overflow-x-auto">
        <table class="datasheet-table">
          <thead>
            <tr>
              <th class="font-display">Item</th>
              <th class="font-display">Descrição</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Tensão de Operação (Saída):</td>
              <td>127VAC ~ 220VAC (K1 - K4)</td>
            </tr>
            <tr>
              <td>Potência (Carga Máxima):</td>
              <td>10A / 2200W por Tomada</td>
            </tr>
            <tr>
              <td>Rede Internet</td>
              <td>Ethernet RJ45 Base-T</td>
            </tr>
            <tr>
              <td>Duração do Ciclo de Reset:</td>
              <td>5.0 Segundos</td>
            </tr>
            <tr>
              <td>Watchdog Timeout:</td>
              <td>45 Segundos (Hardware Reset)</td>
            </tr>
            <tr>
              <td>Sistema Operacional:</td>
              <td>FreeRTOS Multi-Tasking</td>
            </tr>
            <tr>
              <td>Atualização da Versão de Firmware:</td>
              <td>Via OTA (Over The Air)</td>
            </tr>
            <tr>
              <td>Recuperação do Modem:</td>
              <td>Reinicialização Automática via Relé K1</td>
            </tr>
            <tr>
              <td>Proteção Elétrica:</td>
              <td>Fusível de Proteção contra sobrecorrente 10 Amperes</td>
            </tr>
            <tr>
              <td>Comprimento Total (com abas):</td>
              <td>260 mm</td>
            </tr>
            <tr>
              <td>Comprimento do Corpo (caixa):</td>
              <td>240 mm</td>
            </tr>
            <tr>
              <td>Largura do Corpo (caixa):</td>
              <td>80 mm</td>
            </tr>
            <tr>
              <td>Altura do Corpo (caixa):</td>
              <td>40 mm</td>
            </tr>
            <tr>
              <td>Peso:</td>
              <td>0,650 kg</td>
            </tr>
          </tbody>
        </table>

        <hr class="divider" />

        <h2
          class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl"
        >
          2. Arquitetura de Hardware e Relés
        </h2>
        <p>
          O SMR utiliza quatro relés para controle de energia. A lógica de
          hardware é <strong>padronizada</strong> para todos os pinos para garantir
          segurança e previsibilidade.
        </p>

        <!-- Logic Display -->
        <div class="logic-grid">
          <div class="logic-card logic-on">
            <div class="logic-bit font-display">0</div>
            <div class="logic-state font-mono">LOW — ENERGIA LIGADA</div>
            <div class="logic-desc">
              220V liberado. É o estado de repouso padrão. Relé ativado,
              circuito fechado.
            </div>
          </div>
          <div class="logic-card logic-off">
            <div class="logic-bit font-display">1</div>
            <div class="logic-state font-mono">HIGH — ENERGIA CORTADA</div>
            <div class="logic-desc">
              Desligado ou em ciclo de Reset. Relé desativado, circuito aberto.
            </div>
          </div>
        </div>

        <h3
          class="font-display font-bold uppercase text-on-surface mb-4 text-sm"
        >
          Mapeamento de Pinos
        </h3>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Componente</th>
                <th>Pino GPIO</th>
                <th>Função de Controle</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Relé Modem (K1)</strong></td>
                <td><code>GPIO 14</code></td>
                <td>Controle de energia do Modem/Gateway</td>
              </tr>
              <tr>
                <td><strong>Relé PC (K2)</strong></td>
                <td><code>GPIO 32</code></td>
                <td>Controle de energia do PC/NUC</td>
              </tr>
              <tr>
                <td><strong>Relé Auxiliar (K3)</strong></td>
                <td><code>GPIO 12</code></td>
                <td>Saída auxiliar programável</td>
              </tr>
              <tr>
                <td><strong>Relé Auxiliar (K4)</strong></td>
                <td><code>GPIO 33</code></td>
                <td>Saída auxiliar programável</td>
              </tr>
            </tbody>
          </table>
        </div>

        <hr class="divider" />

        <h2
          class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl"
        >
          3. Monitoramento de Conectividade
        </h2>
        <p>
          O sistema opera três tarefas independentes em paralelo (FreeRTOS):
        </p>

        <div class="monitoring-section">
          <!-- Modem Monitoring -->
          <div class="monitor-card">
            <div class="monitor-header">
              <span class="material-symbols-outlined">router</span>
              <h3 class="font-display">
                A. Monitoramento do Modem (Conectividade Global)
              </h3>
            </div>
            <ol class="ordered-list">
              <li>
                <strong>Ping Local:</strong> Testa o IP do Gateway (<code
                  >modemIP</code
                >).
              </li>
              <li>
                <strong>Ping Internet:</strong> Se o local responder, testa o IP <code
                  >8.8.8.8</code
                >.
              </li>
              <li>
                <strong>Reset Automático:</strong> Se houver falha total, o SMR corta
                a energia do modem por <strong>5 segundos</strong> e religa.
              </li>
              <li>
                <strong>Proteção:</strong> Aguarda <strong>5 minutos</strong> entre
                resets e <strong>3 minutos</strong> após um reset (<em
                  >cooldown</em
                >) antes de testar novamente.
              </li>
            </ol>
          </div>
          <!-- PC Monitoring -->
          <div class="monitor-card">
            <div class="monitor-header">
              <span class="material-symbols-outlined">computer</span>
              <h3 class="font-display">
                B. Monitoramento do PC (Monitoramento Garantido)
              </h3>
            </div>
            <p>O SMR utiliza um sistema de "Identidade de Máquina":</p>
            <ol class="ordered-list">
              <li>
                <strong>Discovery (Busca):</strong> Escaneia a rede via ARP.
              </li>
              <li>
                <strong>ID Verification:</strong> Ao achar um IP, o SMR busca o arquivo
                <code>dispositivo.json</code> no PC.
              </li>
              <li>
                <strong>Validação:</strong> O monitoramento só começa se o <code
                  >deviceID</code
                > for encontrado e validado.
              </li>
              <li>
                <strong>Watchdog de Rede:</strong> Se o PC (conhecido pelo ID) falhar
                <strong>3 vezes</strong>, o SMR executa o reset físico da tomada
                K2.
              </li>
            </ol>
          </div>
        </div>

        <div class="attention-text">
          <strong>Sistema Operacional:</strong> FreeRTOS com três tarefas independentes
          em paralelo — <em>Connectivity</em>, <em>Status Reporting</em> e <em
            >Commands Handler</em
          >.
        </div>

        <hr class="divider" />

        <h2
          class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl"
        >
          4. Watchdog (WDT) de Sistema
        </h2>
        <p>
          Para garantir que o SMR nunca "trave", implementamos um Watchdog de
          hardware com timeout de <strong>45 segundos</strong>:
        </p>

        <div class="wdt-panel">
          <div class="wdt-top">
            <div>
              <div class="text-10px text-on-surface-variant font-mono">
                HEARTBEAT TIMEOUT
              </div>
              <div class="wdt-value font-display text-primary">45 SEC</div>
            </div>
            <div class="wdt-action">
              <div class="text-10px text-on-surface-variant font-mono">
                AÇÃO EM FALHA
              </div>
              <div class="wdt-value font-display text-error">REBOOT</div>
            </div>
          </div>
          <div class="wdt-bar">
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment active"></div>
            <div class="wdt-segment"></div>
            <div class="wdt-segment"></div>
            <div class="wdt-segment"></div>
          </div>
          <div class="wdt-tasks">
            <div class="wdt-task">
              <span class="wdt-dot"></span>
              <span class="font-mono text-10px uppercase"
                >Task: Connectivity</span
              >
            </div>
            <div class="wdt-task">
              <span class="wdt-dot"></span>
              <span class="font-mono text-10px uppercase"
                >Task: Status Reporting</span
              >
            </div>
            <div class="wdt-task">
              <span class="wdt-dot"></span>
              <span class="font-mono text-10px uppercase"
                >Task: Commands Handler</span
              >
            </div>
          </div>
        </div>

        <ul class="bullet-list">
          <li>
            <strong>Monitoramento de Tarefas:</strong> Todas as tarefas (Connectivity,
            Status, Commands) devem "avisar" ao WDT que estão vivas.
          </li>
          <li>
            <strong>Ação de Falha:</strong> Se qualquer tarefa travar por mais de
            <strong>45 segundos</strong>, o hardware do ESP32 força um <strong
              >Reboot Imediato</strong
            >.
          </li>
          <li>
            <strong>Proteção de Loops:</strong> Em processos longos (como varredura
            de rede /24), o WDT é resetado internamente para evitar disparos falsos.
          </li>
        </ul>

        <hr class="divider" />

        <h2
          class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl"
        >
          5. Comandos Aceitos (Servidor → SMR)
        </h2>
        <p>
          Os comandos são enviados pelo servidor central para o dispositivo SMR.
          Cada comando altera o estado de um relé específico.
        </p>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Comando</th>
                <th>Valor</th>
                <th>Ação Resultante</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>K1</strong></td>
                <td><code>0</code></td>
                <td><strong>Reset do Modem</strong> (Corte 5s → ON)</td>
              </tr>
              <tr>
                <td><strong>K2</strong></td>
                <td><code>0</code></td>
                <td><strong>Reset do PC</strong> (Corte 5s → ON)</td>
              </tr>
              <tr>
                <td><strong>K3</strong></td>
                <td><code>0</code></td>
                <td><strong>Ligar</strong> Tomada Auxiliar</td>
              </tr>
              <tr>
                <td><strong>K3</strong></td>
                <td><code>1</code></td>
                <td><strong>Desligar</strong> Tomada Auxiliar</td>
              </tr>
              <tr>
                <td><strong>K4</strong></td>
                <td><code>0</code></td>
                <td><strong>Ligar</strong> Tomada Auxiliar</td>
              </tr>
              <tr>
                <td><strong>K4</strong></td>
                <td><code>1</code></td>
                <td><strong>Desligar</strong> Tomada Auxiliar</td>
              </tr>
            </tbody>
          </table>
        </div>

        <hr class="divider" />

        <h2
          class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl"
        >
          6. Avisos de Segurança e Operação
        </h2>

        <div class="safety-section">
          <div class="safety-item">
            <span class="safety-num font-display">01</span>
            <p>
              O dispositivo deve ser utilizado dentro dos escopos de <strong
                >temperatura e umidade</strong
              > prescritos para evitar danos.
            </p>
          </div>
          <div class="safety-item">
            <span class="safety-num font-display">02</span>
            <p>
              Certifique-se de que a sequência de linha e voltagem (<strong
                >220V</strong
              >) esteja correta conforme o mapeamento dos relés.
            </p>
          </div>
          <div class="safety-item">
            <span class="safety-num font-display">03</span>
            <p>
              O <strong>Watchdog de Hardware</strong> forçará um Reboot Imediato se
              qualquer tarefa travar por mais de <strong>45 segundos</strong>.
            </p>
          </div>
          <div class="safety-item">
            <span class="safety-num font-display">04</span>
            <p>
              <strong>Não desmonte</strong> o dispositivo arbitrariamente para não
              comprometer a segurança elétrica e a integridade do firmware.
            </p>
          </div>
        </div>
      </div>

      <Footer />
    </div>
  </div>

  <style>
    /* === Utility Classes === */
    .specs-container {
      max-width: 900px;
      width: 100%;
    }

    .mx-auto {
      margin-left: auto;
      margin-right: auto;
    }
    .p-4 {
      padding: 1rem;
    }
    .flex {
      display: flex;
    }
    .flex-col {
      flex-direction: column;
    }
    .gap-6 {
      gap: 1.5rem;
    }
    .gap-4 {
      gap: 1rem;
    }
    .justify-between {
      justify-content: space-between;
    }
    .items-end {
      align-items: flex-end;
    }
    .items-center {
      align-items: center;
    }
    .border-b {
      border-bottom: 1px solid var(--border-color);
    }
    .border-l-2 {
      border-left: 2px solid var(--border-color);
    }
    .pb-2 {
      padding-bottom: 0.5rem;
    }
    .px-2 {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
    .py-0-5 {
      padding: 0.125rem 0.5rem;
    }
    .rounded-sm {
      border-radius: 0.125rem;
    }
    .italic {
      font-style: italic;
    }
    .tracking-tighter {
      letter-spacing: -0.05em;
    }
    .uppercase {
      text-transform: uppercase;
    }
    .font-bold {
      font-weight: 700;
    }
    .text-10px {
      font-size: 10px;
    }
    .text-xs {
      font-size: 0.75rem;
    }
    .text-xl {
      font-size: 1.25rem;
    }
    .text-2xl {
      font-size: 1.5rem;
    }
    .grid {
      display: grid;
    }
    .grid-cols-2 {
      grid-template-columns: 1fr 1fr;
    }
    .mt-8 {
      margin-top: 2rem;
    }
    .mb-4 {
      margin-bottom: 1rem;
    }
    .mt-4 {
      margin-top: 1rem;
    }
    .mb-8 {
      margin-bottom: 2rem;
    }

    /* Color mappings */
    .text-on-surface-variant {
      color: var(--on-surface-variant);
    }
    .text-on-surface {
      color: var(--on-surface);
    }
    .text-primary {
      color: var(--primary);
    }
    .text-error {
      color: var(--error);
    }
    .bg-surface-container-low {
      background-color: var(--surface-container-low);
    }
    .border-outline-variant {
      border-color: var(--border-color);
    }

    /* Fonts */
    .font-mono {
      font-family: var(--font-mono);
    }
    .font-display {
      font-family: var(--font-display);
    }

    .status-badge {
      background: rgba(var(--primary-rgb), 0.1);
      border: 1px solid var(--primary);
      color: var(--primary);
      font-size: 11px;
      white-space: nowrap;
    }

    /* Technical Illustration */
    .tech-illustration-container {
      width: 100%;
      display: flex;
      justify-content: center;
      /* Background inherits from theme (light/dark) */
      padding: 24px;
      border: 1px solid var(--border-color);
    }

    .tech-illustration {
      max-width: 100%;
      height: auto;
      max-height: 400px;
      object-fit: contain;
      /* Dark mode (default): turn orange vectors to white */
      filter: brightness(0) invert(1);
      transition: filter 0.3s ease;
    }

    :global(html.light) .tech-illustration {
      /* Light mode: turn orange vectors to black */
      filter: brightness(0);
    }

    /* === Content Styles === */
    .manual-content {
      font-family: var(--font-body);
      line-height: 1.6;
      color: var(--on-surface);
    }

    .divider {
      border: none;
      border-top: 1px solid var(--border-color);
      margin: 32px 0;
    }

    /* Tables */
    .table-wrapper {
      overflow-x: auto;
      margin-bottom: 24px;
      width: 100%;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .data-table th,
    .data-table td {
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }

    .data-table th {
      background-color: var(--surface-container-low);
      color: var(--on-surface-variant);
      font-family: var(--font-mono);
      text-transform: uppercase;
      font-size: 12px;
    }

    /* Datasheet */
    .datasheet-wrapper {
      margin: 24px 0;
      border: 1px solid var(--border-color);
      width: 100%;
    }

    .datasheet-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--surface-container-low);
    }

    .datasheet-table th,
    .datasheet-table td {
      border: 1px solid var(--border-color);
      padding: 12px;
    }

    .datasheet-table th {
      background-color: var(--surface-container-high);
      color: var(--primary);
      font-weight: 800;
    }

    .datasheet-table td:first-child {
      background-color: var(--surface-container);
      width: 40%;
      font-weight: 700;
    }

    /* Logic Grid */
    .logic-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 24px 0;
    }

    @media (max-width: 640px) {
      .logic-grid {
        grid-template-columns: 1fr;
      }
      .grid-cols-2 {
        grid-template-columns: 1fr;
      }
    }

    .logic-card {
      padding: 20px;
      border-left: 4px solid var(--border-color);
      background-color: var(--surface-container-low);
    }

    .logic-card.logic-on {
      border-left-color: var(--primary);
    }

    .logic-bit {
      font-size: 2.5rem;
      font-weight: bold;
      color: var(--primary);
    }

    /* Monitoring */
    .monitoring-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    @media (max-width: 768px) {
      .monitoring-section {
        grid-template-columns: 1fr;
      }
    }

    .monitor-card {
      background-color: var(--surface-container-low);
      border: 1px solid var(--border-color);
      padding: 20px;
    }

    /* WDT Panel */
    .wdt-panel {
      background-color: var(--surface-container-low);
      border: 1px solid var(--border-color);
      padding: 24px;
      margin-bottom: 8px;
    }

    .wdt-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .wdt-bar {
      display: flex;
      gap: 4px;
      margin: 20px 0;
    }
    .wdt-segment {
      flex: 1;
      height: 10px;
      background-color: var(--surface-container);
    }
    .wdt-segment.active {
      background-color: var(--primary);
    }

    /* Safety */
    .safety-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 768px) {
      .safety-section {
        grid-template-columns: 1fr;
      }
    }

    .safety-item {
      display: flex;
      gap: 16px;
      padding: 16px;
      border-left: 3px solid var(--error);
      background: rgba(var(--error-rgb, 255, 0, 0), 0.05);
    }

    .safety-num {
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--error);
      opacity: 0.5;
    }

    /* Payload */
    .payload-code {
      display: inline-block;
      padding: 4px 12px;
      border: 1px solid var(--border-color);
      font-family: var(--font-mono);
      font-weight: bold;
      color: var(--error);
    }

    .payload-code.ok {
      color: #4caf50;
      border-color: #4caf50;
    }
  </style>
</Layout>
