---
import Layout from '../layouts/Layout.astro';
import SmartRulerInstallScene from '../components/SmartRulerInstallScene';
import Footer from '../components/Footer.astro';
---

<Layout title="Smart Ruler Eletromidia | Instalação">
  <div class="max-w-4xl mx-auto p-4 flex flex-col gap-6">
    
    <!-- 3D Header -->
    <div class="flex justify-between items-end border-b border-outline-variant pb-2">
      <div>
        <h1 class="text-2xl font-bold uppercase tracking-tighter italic text-on-surface font-display">PROCEDIMENTO PARA INSTALAÇÃO DO DISPOSITIVO</h1>
      </div>
      <div class="status-badge px-2 py-0-5 rounded-sm italic font-mono">VERSÃO_V2.0</div>
    </div>

    <!-- Main Content Area -->
    <div class="grid grid-cols-1 md-grid-cols-2 gap-6 items-start" id="interactive-content-wrapper">
      
      <!-- Three.js Canvas & Mobile Steps Wrapper -->
      <div class="canvas-container flex flex-row sharp-border border border-outline-variant" id="threejs-container">
        
        <!-- 3D Area -->
        <div class="flex-grow relative h-full w-full overflow-hidden" style="min-width: 0;">
          <div class="absolute top-4 left-4 z-10">
            <div class="flex items-center gap-2 text-10px text-primary font-bold font-mono">
              <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
              VISUALIZAÇÃO EM TEMPO REAL
            </div>
          </div>
          <div class="absolute bottom-4 left-4 z-10 text-10px text-on-surface-variant font-mono desktop-steps-container">
            COORD: 23.5505° S, 46.6333° W
          </div>
          <SmartRulerInstallScene client:load />
        </div>

        <!-- Mobile Step Menu (Sidebar layout) -->
        <nav class="w-[115px] flex flex-col gap-1 z-20 overflow-y-visible no-scrollbar mobile-steps-container" data-purpose="step-navigation" style="flex-shrink: 0; align-self: center;">
          <button class="step-btn-mobile active flex flex-col text-left transition-transform" onclick="updateStep(1)">
            <span class="number-box">01</span>
            <span class="step-text">CABO DE<br/>ALIMENTAÇÃO</span>
          </button>
          
          <button class="step-btn-mobile flex flex-col text-left transition-transform" onclick="updateStep(2)">
            <span class="number-box">02</span>
            <span class="step-text">ALIMENTAÇÃO<br/>MODEM</span>
          </button>
          
          <button class="step-btn-mobile flex flex-col text-left transition-transform" onclick="updateStep(3)">
            <span class="number-box">03</span>
            <span class="step-text">CONEXÃO<br/>PC NUC</span>
          </button>
          
          <button class="step-btn-mobile flex flex-col text-left transition-transform" onclick="updateStep(4)">
            <span class="number-box">04</span>
            <span class="step-text">CABO<br/>ETHERNET</span>
          </button>

          <!-- Interaction Prompt (Scroll down) -->
          <div class="chevron-wrapper" style="background-color: #ED712E; padding-bottom: 6px; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 15px), 50% 100%, 0 calc(100% - 15px)); margin-top: 2px; cursor: pointer;" onclick="document.querySelector('.manual-content').scrollIntoView({ behavior: 'smooth' });">
            <div class="chevron-inner flex flex-col items-center justify-center" style="background-color: #111318; padding: 8px 4px 16px 4px; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 15px), 50% 100%, 0 calc(100% - 15px));">
              <span style="font-size: 9px; color: #FFFFFF;" class="font-bold text-center leading-tight uppercase font-display">CONTINUE<br/>ROLANDO<br/>ABAIXO</span>
            </div>
          </div>
        </nav>
      </div>

      <!-- Installation Steps (Desktop Only) -->
      <div class="bg-surface-container-low p-4 sharp-border border border-outline-variant h-full desktop-steps-container">
        <h2 class="text-xs font-bold text-on-surface-variant mb-4 uppercase tracking-widest font-mono">PROTOCOLO DE INSTALAÇÃO</h2>
        
        <div class="flex flex-col gap-2">
          <button class="step-btn active w-full text-left p-3 flex gap-4 items-center group" onclick="updateStep(1)">
            <span class="font-mono text-on-surface-variant group-active-text-primary">01</span>
            <div>
              <div class="text-sm font-bold uppercase font-display">Cabo de Alimentação</div>
              <div class="text-10px text-on-surface-variant font-mono">CONEXAO_ENTRADA_AC</div>
            </div>
          </button>
          
          <button class="step-btn w-full text-left p-3 flex gap-4 items-center group" onclick="updateStep(2)">
            <span class="font-mono text-on-surface-variant group-active-text-primary">02</span>
            <div>
              <div class="text-sm font-bold uppercase font-display">Alimentação Modem</div>
              <div class="text-10px text-on-surface-variant font-mono">GATEWAY_PRONTO</div>
            </div>
          </button>
          
          <button class="step-btn w-full text-left p-3 flex gap-4 items-center group" onclick="updateStep(3)">
            <span class="font-mono text-on-surface-variant group-active-text-primary">03</span>
            <div>
              <div class="text-sm font-bold uppercase font-display">Conexão PC NUC</div>
              <div class="text-10px text-on-surface-variant font-mono">SINCRONIZACAO_NUCLEO</div>
            </div>
          </button>
          
          <button class="step-btn w-full text-left p-3 flex gap-4 items-center group" onclick="updateStep(4)">
            <span class="font-mono text-on-surface-variant group-active-text-primary">04</span>
            <div>
              <div class="text-sm font-bold uppercase font-display">Cabo Ethernet</div>
              <div class="text-10px text-on-surface-variant font-mono">LINK_DE_DADOS_ESTABELECIDO</div>
            </div>
          </button>
        </div>
      </div>
      
    </div>

    <!-- Technical Footer Info -->
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-surface-container-low p-3 border-l-2 border-primary shadow-sm">
        <div class="text-10px text-on-surface-variant font-mono">MODELO MCU</div>
        <div class="text-xs font-bold uppercase text-on-surface font-display">ESP32-WROOM-32U</div>
      </div>
      <div class="bg-surface-container-low p-3 border-l-2 border-primary shadow-sm">
        <div class="text-10px text-on-surface-variant font-mono">FIRMWARE</div>
        <div class="text-xs font-bold uppercase text-on-surface font-display">V.2.0 COM OTA</div>
      </div>
    </div>

    {/* Documentação do Manual */}
    <div class="manual-content mt-8">
      <p class="lead-text">
        Este manual prático orienta o passo a passo de instalação e conexão da <strong>Smart Ruler (Régua Inteligente IoT)</strong> nos MUBs (Mobiliários Urbanos para Informação) da Eletromidia. Siga a ordem rigorosamente para garantir o funcionamento do IoT Hub e evitar retrabalhos.
      </p>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">1. Check-list Pré-Instalação (Antes de iniciar)</h2>
      <p>A Smart Ruler não acompanha o cabo de força. Antes de subir no equipamento ou iniciar a manutenção, garanta que você tem em mãos:</p>
      <ul class="checklist pre-install-checklist">
        <li><input type="checkbox" class="pre-check-item" /> <strong>Chave de boca de 8mm</strong> (ou chave canhão/catraca compatível).</li>
        <li><input type="checkbox" class="pre-check-item" /> <strong>Cabo de energia tripolar</strong> (necessário para alimentação principal).</li>
        <li><input type="checkbox" class="pre-check-item" /> <strong>Smart Ruler</strong> e a <strong>Barra de travamento metálica</strong> (inclusa com o equipamento).</li>
        <li><input type="checkbox" class="pre-check-item" /> <strong>Parafuso M5 sextavado</strong> (para a fixação).</li>
        <li><input type="checkbox" class="pre-check-item" /> Multímetro (recomendado para atestar a tensão do MUB).</li>
      </ul>
      <div id="pre-install-approved" class="hidden mt-4 text-primary font-bold uppercase tracking-widest font-mono text-center bg-primary/10 p-2 border border-primary">
        INSTALAÇÃO APROVADA
      </div>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">2. Fixação Mecânica no MUB</h2>
      <p>A régua deve ser instalada de forma que os cabos fiquem organizados e o acesso futuro seja facilitado.</p>
      <ol class="ordered-list">
        <li><strong>Localize o Ponto Exato:</strong> Identifique o <strong>chassi superior exposto</strong> do MUB. Esta é a área homologada para garantir ventilação e otimização de espaço.</li>
        <li><strong>Posicione a Régua:</strong> Encaixe a Smart Ruler juntamente com a <strong>barra de travamento metálica</strong>.</li>
        <li><strong>Trave o Equipamento:</strong> Utilize a chave de boca de 8mm para apertar firmemente o <strong>parafuso M5 sextavado</strong>.</li>
      </ol>
      <p class="attention-text"><em>Atenção:</em> Certifique-se de que a régua não esteja solta ou vibrando, pois isso pode causar desconexão dos cabos com o tempo.</p>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">3. Alimentação Elétrica (Energização)</h2>
      <p>A Smart Ruler foi projetada para facilitar a vida em campo, sendo <strong>Bivolt Automática (110V/220V)</strong>. Não há chave seletora de tensão.</p>
      <ol class="ordered-list">
        <li><strong>Inspeção do Fusível:</strong> Antes de plugar qualquer coisa, verifique visualmente se o <strong>fusível de 10 Amperes</strong> está íntegro e bem encaixado no compartimento.</li>
        <li><strong>Conexão Principal:</strong> Conecte o <strong>cabo de energia tripolar</strong> na entrada de alimentação da Smart Ruler.</li>
        <li><strong>Energize:</strong> Ligue a outra ponta do cabo na rede de alimentação do MUB.</li>
      </ol>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">4. Mapeamento das Tomadas (Obrigatório)</h2>
      <p>A ordem de ligação é essencial para que o acionamento remoto via <strong>IoT Hub da Eletromidia</strong> funcione corretamente. <strong class="text-error">Nunca inverta o PC e o Modem.</strong></p>
      <p>Siga a ordem física da régua <strong>(De Cima para Baixo)</strong>:</p>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Posição</th>
              <th>Nome na Régua</th>
              <th>O que ligar aqui?</th>
              <th>Comportamento / Função</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>1ª (Topo)</strong></td>
              <td><code>ENTRADA DIRETA</code></td>
              <td><strong>Uso do Técnico (Ferramentas)</strong></td>
              <td><strong>Energia Constante.</strong> Não possui controle remoto. Feita para você plugar seu notebook, carregador ou ferramenta durante a manutenção.</td>
            </tr>
            <tr>
              <td><strong>2ª</strong></td>
              <td><code>MODEM</code></td>
              <td><strong>Modem do MUB</strong></td>
              <td><strong>Controlada via IoT Hub.</strong> Dedicada exclusivamente para manter a conectividade da tela.</td>
            </tr>
            <tr>
              <td><strong>3ª</strong></td>
              <td><code>PC</code></td>
              <td><strong>PC NUC do MUB</strong></td>
              <td><strong>Controlada via IoT Hub.</strong> Dedicada ao player/computador que roda a mídia.</td>
            </tr>
            <tr>
              <td><strong>4ª (Base)</strong></td>
              <td><code>TOMADA 3</code></td>
              <td><strong>Vazia / Novos Dispositivos</strong></td>
              <td><strong>Controlada via IoT Hub.</strong> Deixe livre. É a porta de expansão para implementações futuras.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">5. Validação e Testes no Local</h2>
      <p>A Smart Ruler não é apenas um filtro de linha, ela é o centro do ecossistema IoT do MUB. Após conectar tudo:</p>
      <ol class="ordered-list">
        <li>Verifique se o <strong>Modem</strong> e o <strong>PC NUC</strong> iniciaram corretamente após serem plugados nas tomadas 2 e 3.</li>
        <li>Confirme com o Centro de Controle (NOC / Suporte Técnico) se o equipamento já está visível na plataforma <strong>IoT Hub da Eletromidia</strong>.</li>
        <li>Solicite um teste de <strong>Acionamento Remoto</strong> (pedir para o suporte desligar e ligar a tomada do PC NUC, por exemplo) para atestar a comunicação.</li>
      </ol>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">6. Dicas de Manutenção Rápida (Troubleshooting)</h2>
      <p>Se o equipamento não ligar ou apresentar falha de comunicação, faça estas validações antes de acionar o suporte:</p>
      <ul class="bullet-list">
        <li><strong>MUB totalmente apagado:</strong> Desplugue o cabo tripolar e teste a integridade do <strong>fusível de 10A</strong>. Se estiver rompido, substitua.</li>
        <li><strong>PC ou Modem não ligam:</strong> Verifique se não foram plugados por engano na "Tomada 3" (que pode estar desativada via software pelo IoT Hub) em vez das tomadas corretas (2 e 3).</li>
        <li><strong>Mau contato:</strong> Garanta que os plugues das fontes do PC e do Modem estão inseridos até o fim. Excesso de umidade ou cabos esticados podem afrouxar a conexão.</li>
      </ul>

      <div class="alert-box">
        <strong>Precisa de ajuda avançada?</strong> Em caso de falhas não resolvidas na documentação, isole o problema (teste ligar o PC na Entrada Direta para garantir que não é a fonte do PC queimada) e entre em contato com o Suporte Técnico da Eletromidia relatando os testes já realizados.
      </div>

      <hr class="divider" />

      <h2 class="font-display font-bold uppercase text-primary mt-8 mb-4 text-xl">7. Checklist de Comissionamento Digital</h2>
      <p class="lead-text">Preencha os campos abaixo após concluir a instalação para gerar o protocolo de ativação no IoT Hub.</p>

      <div class="bg-surface-container-low sharp-border border border-outline-variant p-6 mt-4">
        <form id="commissioning-form" class="flex flex-col gap-6">
          
          <!-- Dados do Técnico e Local -->
          <div class="flex flex-col gap-4">
            <div class="grid grid-cols-1 md-grid-cols-2 gap-4">
              <div class="flex flex-col gap-1">
                <label class="text-10px font-mono uppercase text-on-surface-variant">Nome do Técnico</label>
                <input type="text" class="input-field" placeholder="NOME_COMPLETO" required />
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-10px font-mono uppercase text-on-surface-variant">Código do MUB</label>
                <input type="text" class="input-field" placeholder="MUB_XXXX" required />
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-10px font-mono uppercase text-on-surface-variant">Código Smart Ruler</label>
                <input type="text" class="input-field" placeholder="SN_ELT_XXXX" required />
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-10px font-mono uppercase text-on-surface-variant">Protocolo IoT Hub</label>
                <input type="text" class="input-field" placeholder="AGUARDANDO_CONEXÃO..." readonly id="protocol-display" />
              </div>
            </div>
            
            <div class="flex flex-col gap-1">
              <label class="text-10px font-mono uppercase text-on-surface-variant">Endereço de Instalação / Referência</label>
              <input type="text" class="input-field" placeholder="AV. PAULISTA, 1000 - SÃO PAULO/SP" required />
            </div>
          </div>

          <div class="divider-mini"></div>

          <!-- Checklist Table -->
          <div class="table-wrapper">
            <table class="data-table checklist-interactive">
              <thead>
                <tr>
                  <th width="40">#</th>
                  <th>Item de Verificação</th>
                  <th width="80" class="text-center">Status</th>
                  <th>Observações</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>01</td>
                  <td>Fixação mecânica sem folgas/vibração</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
                <tr>
                  <td>02</td>
                  <td>Energização e fusível 10A ok</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
                <tr>
                  <td>03</td>
                  <td>Modem (Tomada 2) inicializado</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
                <tr>
                  <td>04</td>
                  <td>PC NUC (Tomada 3) inicializado</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
                <tr>
                  <td>05</td>
                  <td>Tensão na tomada de serviço ok</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
                <tr>
                  <td>06</td>
                  <td>Cabo RJ45 conectado e link ativo</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
                <tr>
                  <td>07</td>
                  <td>Status Online confirmado no IoT Hub</td>
                  <td class="text-center"><input type="checkbox" class="check-item" /></td>
                  <td><input type="text" class="table-input" placeholder="Opcional..." /></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Relatório de Problemas (Condicional) -->
          <div id="issue-report-area" class="hidden flex flex-col gap-2">
            <label class="text-xs font-bold text-error uppercase font-mono">Relatório de Ocorrências / Pendências</label>
            <textarea class="textarea-field" placeholder="Descreva brevemente o problema encontrado..."></textarea>
          </div>

          <!-- Ação Final -->
          <div class="flex justify-between items-center mt-4">
            <div class="text-10px font-mono text-on-surface-variant">
              SISTEMA_REPORT_V1.0 // PENDÊNCIAS: <span id="pending-count">7</span>
            </div>
            <button type="submit" class="action-btn">
              FINALIZAR E ENVIAR RELATÓRIO
            </button>
          </div>
        </form>
      </div>
    </div>
    <Footer />
  </div>
</Layout>

<script is:inline>
  window.updateStep = function(stepIndex) {
    const buttons = document.querySelectorAll('.step-btn');
    buttons.forEach((btn, idx) => {
      if(idx === stepIndex - 1) {
        btn.classList.add('active');
        btn.querySelector('span.font-mono').classList.add('group-active-text-primary');
      } else {
        btn.classList.remove('active');
        btn.querySelector('span.font-mono').classList.remove('group-active-text-primary');
      }
    });
    
    const mobileButtons = document.querySelectorAll('.step-btn-mobile');
    mobileButtons.forEach((btn, idx) => {
      if(idx === stepIndex - 1) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    // Dispatch custom event so the React Three.js component can pick it up
    window.dispatchEvent(new CustomEvent('smartruler:step', { detail: { step: stepIndex } }));
  }

  // Checklist Logic
  document.addEventListener('DOMContentLoaded', () => {
    const checkboxes = document.querySelectorAll('.check-item');
    const pendingCount = document.getElementById('pending-count');
    const issueArea = document.getElementById('issue-report-area');
    const form = document.getElementById('commissioning-form');
    const protocolDisplay = document.getElementById('protocol-display');

    const updateStatus = () => {
      const checked = document.querySelectorAll('.check-item:checked').length;
      const total = checkboxes.length;
      pendingCount.textContent = total - checked;
      
      // If any item is not checked, show the issue report area
      if (checked < total) {
        issueArea.classList.remove('hidden');
      } else {
        issueArea.classList.add('hidden');
      }
    };

    const preCheckboxes = document.querySelectorAll('.pre-check-item');
    const preApproved = document.getElementById('pre-install-approved');

    const updatePreStatus = () => {
      const checked = document.querySelectorAll('.pre-check-item:checked').length;
      if (checked === preCheckboxes.length && preCheckboxes.length > 0) {
        preApproved.classList.remove('hidden');
      } else {
        preApproved.classList.add('hidden');
      }
    };

    preCheckboxes.forEach(cb => {
      cb.addEventListener('change', updatePreStatus);
    });

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateStatus);
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const protocol = 'ELT-' + Math.random().toString(36).substr(2, 9).toUpperCase();
      protocolDisplay.value = protocol;
      
      alert('Relatório de Comissionamento Gerado!\nProtocolo: ' + protocol + '\n\nOs dados foram enviados para o IoT Hub (Simulação).');
      
      // Here you would typically send data to Netlify Functions or Google Cloud
      console.log('Sending report...', {
        protocol,
        timestamp: new Date().toISOString(),
        technician: form.querySelector('input[type="text"]').value,
        status: pendingCount.textContent === '0' ? 'SUCESSO' : 'PENDENTE'
      });
    });
  });
</script>

<style>
  /* Mimicking Tailwind classes and formatting exact to code.html */
