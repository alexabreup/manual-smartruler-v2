---
const currentPath = Astro.url.pathname;
---
<aside class="sidebar">
  <div class="sidebar-header">
    <div class="user-profile">
      <div class="user-avatar">
        <span class="material-symbols-outlined">person</span>
      </div>
      <div class="user-info">
        <div class="user-name">OPERADOR_01</div>
        <div class="user-status">VERSÃO_V2.06 ATIVO</div>
      </div>
    </div>
    <button class="diagnostic-btn">Executar Diagnóstico do Sistema</button>
  </div>
  
  <nav class="sidebar-nav">
    <a class={`nav-item ${currentPath === '/' ? 'active' : ''}`} href="/">
      <span class="material-symbols-outlined">grid_view</span> PAINEL DE CONTROLE
    </a>
    <a class={`nav-item ${currentPath === '/instalacao' || currentPath.startsWith('/instalacao/') ? 'active' : ''}`} href="/instalacao">
      <span class="material-symbols-outlined">menu_book</span> MANUAL
    </a>
    <a class={`nav-item ${currentPath === '/especificacoes' || currentPath.startsWith('/especificacoes/') ? 'active' : ''}`} href="/especificacoes">
      <span class="material-symbols-outlined">analytics</span> DADOS
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="footer-logo">
      <span class="footer-logo-img" aria-label="Eletromidia"></span>
    </div>
    <div class="footer-credits">
      <p>Produzido por <strong>Alexandre de Abreu Pereira</strong></p>
      <a href="mailto:alexandre.abreu@eletromidia.com.br" class="credit-link">alexandre.abreu@eletromidia.com.br</a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    height: 100%;
    display: none;
    flex-direction: column;
    z-index: 40;
    background-color: var(--surface-container);
    border-right: 1px solid var(--border-color);
    width: 280px;
    padding-top: 80px;
  }

  @media (min-width: 1024px) {
    .sidebar {
      display: flex;
    }
  }

  .sidebar-header {
    padding: 0 24px;
    margin-bottom: 48px;
  }

  .user-profile {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
  }

  .user-avatar {
    width: 40px;
    height: 40px;
    background-color: rgba(var(--primary-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(var(--primary-rgb), 0.4);
  }

  .user-avatar .material-symbols-outlined {
    color: var(--primary);
  }

  .user-name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--primary);
    text-transform: uppercase;
  }

  .user-status {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--on-surface-variant);
    opacity: 0.6;
  }

  .diagnostic-btn {
    width: 100%;
    padding: 4px 0;
    border: 1px solid var(--primary);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 10px;
    background: transparent;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s;
  }

  .diagnostic-btn:hover {
    background-color: rgba(var(--primary-rgb), 0.1);
  }

  .sidebar-nav {
    flex-grow: 1;
  }

  .nav-item {
    padding: 16px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface-variant);
    text-decoration: none;
    transition: all 0.2s;
  }

  .nav-item:hover {
    background-color: rgba(var(--primary-rgb), 0.05);
  }

  .nav-item.active {
    background-color: rgba(var(--primary-rgb), 0.1);
    color: var(--primary);
    border-right: 4px solid var(--primary);
  }

  .sidebar-footer {
    margin-top: auto;
    padding: 24px;
    border-top: 1px solid var(--border-color);
  }

  .footer-logo-img {
    height: 32px;
    width: 150px;
    display: block;
    background-color: #ffffff; /* Cor para modo escuro */
    -webkit-mask-image: url('/logo-eletromidia.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: left center;
    mask-image: url('/logo-eletromidia.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: left center;
    transition: background-color 0.3s ease;
  }

  :global(.light) .footer-logo-img {
    background-color: var(--primary); /* Cor para modo claro */
  }
</style>
