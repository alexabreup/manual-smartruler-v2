---
import type { Props } from '@astrojs/starlight/props';
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
---

<aside class="flex flex-col h-full bg-surface-container overflow-y-auto">
  <div class="px-6 mb-8 mt-6">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-10 h-10 bg-primary/20 flex items-center justify-center border border-primary/40">
        <span class="material-symbols-outlined text-primary">person</span>
      </div>
      <div>
        <div class="font-label-caps text-label-caps text-primary m-0 leading-tight">OPERATOR_01</div>
        <div class="font-label-caps text-[10px] text-on-surface-variant opacity-60 m-0 leading-tight">VERSÃO_V2.0 ATIVO</div>
      </div>
    </div>
    <button class="w-full py-1 border border-primary text-primary font-label-caps text-[10px] hover:bg-primary/10 transition-all bg-transparent cursor-pointer">
      RUN DIAGNOSTIC
    </button>
  </div>
  
  <div class="flex-grow px-2 custom-starlight-sidebar">
    <DefaultSidebar {...Astro.props} />
  </div>

  <div class="mt-auto p-6 border-t border-black/10 bg-surface-container-low">
    <div class="footer-logo">
      <span class="footer-logo-img" aria-label="Eletromidia"></span>
    </div>
  </div>
</aside>

<style is:global>
  .footer-logo-img {
    height: 32px;
    width: 150px;
    display: block;
    background-color: #ffffff;
    -webkit-mask-image: url('/logo-eletromidia.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: left center;
    mask-image: url('/logo-eletromidia.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: left center;
    transition: background-color 0.3s ease;
  }

  .light .footer-logo-img {
    background-color: var(--primary);
  }
  .custom-starlight-sidebar ul {
    list-style: none;
    padding-left: 0;
  }
  .custom-starlight-sidebar a {
    color: var(--color-on-surface-variant) !important;
    font-family: var(--font-label-caps) !important;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.1em;
    padding: 0.75rem 1rem !important;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s;
    text-decoration: none !important;
    border-radius: 0 !important;
    margin-bottom: 2px;
  }
  .custom-starlight-sidebar a:hover,
  .custom-starlight-sidebar a[aria-current="page"] {
    background-color: rgba(237, 113, 46, 0.1) !important;
    color: var(--color-primary) !important;
    border-left: 4px solid var(--color-primary);
    padding-left: calc(1rem - 4px) !important;
  }
  .custom-starlight-sidebar details {
    margin-bottom: 0.5rem;
  }
  .custom-starlight-sidebar details summary {
    font-family: var(--font-headline-md);
    text-transform: uppercase;
    color: var(--color-on-surface);
    font-size: 14px;
    letter-spacing: 0.05em;
    padding: 0.5rem 1rem;
  }
</style>
