---
import type { Props } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import MobileMenuToggle from '@astrojs/starlight/components/MobileMenuToggle.astro';
---

<header class="bg-surface border-b border-black/10 w-full top-0 z-50 flex items-center h-16 md:h-20 px-4 md:px-6">
  <div class="flex justify-between items-center w-full max-w-[1280px] mx-auto">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-2 text-primary font-bold no-underline uppercase tracking-tight">
        SMART RULER
      </a>
    </div>
    

    <div class="flex items-center gap-4">
      <div class="md:hidden flex items-center">
        <MobileMenuToggle {...Astro.props} />
      </div>
      <div class="hidden md:block">
        <Search {...Astro.props} />
      </div>
      <div class="flex gap-2 text-primary items-center">

        <div class="hidden md:block">
           <ThemeSelect {...Astro.props} />
        </div>
      </div>
    </div>
  </div>
</header>
